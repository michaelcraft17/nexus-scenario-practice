# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional -- defaults to claude-opus-5. Swap to claude-sonnet-5 or
# claude-haiku-4-5 for cheaper/faster iteration during the hackathon.
ANTHROPIC_MODEL=claude-opus-5

# Optional -- port the Express server listens on.
PORT=3001

# Optional -- only needed if the client is deployed separately from the
# server (e.g. client on Vercel, server on Railway). Set to the client's
# deployed origin, e.g. https://includai.vercel.app
CORS_ORIGIN=
