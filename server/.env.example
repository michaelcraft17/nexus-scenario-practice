# Get an API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional -- defaults to gpt-4o. Currently running gpt-5.6-luna in
# production (OpenAI's cheapest current chat-capable model) to keep a
# publicly-shared demo affordable. gpt-4o-mini is a good middle ground if
# Luna's reply quality feels too thin.
OPENAI_MODEL=gpt-5.6-luna

# Optional -- port the Express server listens on.
PORT=3001

# Optional -- only needed if the client is deployed separately from the
# server (e.g. client on Vercel, server on Railway). Set to the client's
# deployed origin, e.g. https://includai.vercel.app
CORS_ORIGIN=

# Optional -- defaults to 500. Total /api requests allowed across ALL users
# combined per day (UTC), on top of the per-IP rate limit in
# server/src/middleware/costGuard.js -- the real safeguard once this app is
# publicly reachable and no longer just you testing it locally.
DAILY_REQUEST_CAP=500
